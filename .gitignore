vendor/deepseek-harness/node_modules/
vendor/deepseek-harness/apps/web/dist/
# host-side tsc emits declaration/map artifacts beside the sources; keep the
# sources tracked and ignore the emitted build droppings.
vendor/deepseek-harness/**/src/*.js
vendor/deepseek-harness/**/src/*.js.map
vendor/deepseek-harness/**/src/*.d.ts
vendor/deepseek-harness/**/src/*.d.ts.map
# Hand-written CSS module declarations are source, not tsc droppings; without
# them a fresh checkout cannot typecheck or build the client packages.
!vendor/deepseek-harness/**/src/css-modules.d.ts
